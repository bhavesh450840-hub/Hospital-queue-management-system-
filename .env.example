# Copy to .env for local development. Never commit .env.
# Required in production: a long random string (e.g. `openssl rand -hex 48`).
SESSION_SECRET=change-me-to-a-long-random-string

# First-run staff account. When both are set, this account is created on startup
# (only if it does not already exist). If omitted, a demo login staff/staff123 is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# production | development
NODE_ENV=production

# Server port (most hosts inject PORT automatically).
PORT=3000

# Where the SQLite file is written. Point this at a mounted persistent disk if available.
DATA_DIR=./database
